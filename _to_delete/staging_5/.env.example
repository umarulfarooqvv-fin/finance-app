# Copy this file to .env.local and fill in values.

# Google Sheet ID of "Daily Spent" (already set to yours)
DAILY_SPENT_SHEET_ID=1orMNGjhPKlKPTIQDKFcxd48Fip9K5Wuf5FdLkFWyimc

# Tab name holding form responses
DAILY_SPENT_TAB=Form Responses 1

# Apps Script web app URL (after you deploy apps-script/Code.gs — see SETUP.md)
APPS_SCRIPT_URL=

# Shared secret. Must match the TOKEN constant inside Code.gs
APPS_SCRIPT_TOKEN=change-me-to-something-random

# OPTIONAL — set this on public deployments (Vercel). When set, the app shows
# a PIN screen; this value IS the PIN (e.g. 4–6 digits). Empty = no lock.
APP_ACCESS_KEY=

# OPTIONAL — push notifications for card dues & recurring items.
# Pick a long random topic name, set it here, and subscribe to the same topic
# in the ntfy app (iOS/Android) or at https://ntfy.sh/<topic>.
NTFY_TOPIC=

# OPTIONAL — protects /api/alerts. On Vercel, generate any random string;
# Vercel's cron automatically authenticates with it.
CRON_SECRET=
