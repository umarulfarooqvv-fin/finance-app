# Copy this file to .env.local and fill in values.

# ---------------------------------------------------------------------------
# Supabase (Postgres) — the app's database. Create a free project at
# supabase.com, run db/schema.sql in the SQL editor, then copy these from
# Project Settings → API. The SERVICE key is server-only; never expose it.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Secret for the iPhone Shortcut ingestion endpoint (/api/entry) and the
# one-time /api/import. Use a long random string; put the same value in the
# Shortcut's URL as ?token=...
INGEST_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — only needed once, to import your existing Google Sheet history
# into Supabase (POST /api/import). After importing you can remove these.
# ---------------------------------------------------------------------------
DAILY_SPENT_SHEET_ID=1orMNGjhPKlKPTIQDKFcxd48Fip9K5Wuf5FdLkFWyimc
DAILY_SPENT_TAB=Form Responses 1
DAILY_INCOME_TAB=Form Responses 2
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# OPTIONAL — PIN lock for a public (Vercel) deployment. When set, the app
# shows a PIN screen; this value IS the PIN. Empty = no lock.
APP_ACCESS_KEY=

# OPTIONAL — push notifications for card dues, recurring items and budgets.
NTFY_TOPIC=

# OPTIONAL — protects the daily /api/alerts cron on Vercel.
CRON_SECRET=
