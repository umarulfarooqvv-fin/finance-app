# Copy this file to .env.local and fill in values.

# ---------------------------------------------------------------------------
# Supabase (Postgres) — the app's database. Create a free project at
# supabase.com, run db/schema.sql in the SQL editor, then copy these from
# Project Settings → API. The SERVICE key is server-only; never expose it.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Secret for the iPhone Shortcut ingestion endpoint (/api/entry) and the
# one-time /api/import. Use a long random string; put the same value in the
# Shortcut's URL as ?token=...
INGEST_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — only needed once, to import your existing Google Sheet history
# into Supabase (POST /api/import). After importing you can remove these.
# ---------------------------------------------------------------------------
DAILY_SPENT_SHEET_ID=1orMNGjhPKlKPTIQDKFcxd48Fip9K5Wuf5FdLkFWyimc
DAILY_SPENT_TAB=Form Responses 1
DAILY_INCOME_TAB=Form Responses 2
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# OPTIONAL — PIN lock for a public (Vercel) deployment. When set, the app
# shows a PIN screen; this value IS the PIN. Empty = no lock.
APP_ACCESS_KEY=

# OPTIONAL — push notifications for card dues, recurring items and budgets.
NTFY_TOPIC=

# OPTIONAL — protects the daily /api/alerts cron on Vercel.
CRON_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — model assistance for voice entry.
#
# Voice entry works with NONE of this set. A deterministic parser in
# src/lib/ai/local-parser.ts reads the transcript offline: it is free, instant,
# and cannot invent a payment method because it can only return one from the
# app's own list. A model is a FALLBACK for phrasing it cannot read, and it may
# only fill fields the local parser left null — it never overwrites them.
#
#   ENTRY_AI=off                 local parser only (the default)
#   ENTRY_AI=openai-compatible   + ENTRY_AI_BASE_URL, ENTRY_AI_KEY, ENTRY_AI_MODEL
#   ENTRY_AI=gemini              + GEMINI_API_KEY [, ENTRY_AI_MODEL]
#   ENTRY_AI=anthropic           + ANTHROPIC_API_KEY [, ENTRY_AI_MODEL]
#
# Free options, all of which speak the OpenAI chat-completions shape:
#
#   Groq        ENTRY_AI_BASE_URL=https://api.groq.com/openai/v1
#               ENTRY_AI_MODEL=llama-3.3-70b-versatile      (free tier, fast)
#   OpenRouter  ENTRY_AI_BASE_URL=https://openrouter.ai/api/v1
#               ENTRY_AI_MODEL=<any id ending ":free">
#   Ollama      ENTRY_AI_BASE_URL=http://localhost:11434/v1
#               ENTRY_AI_MODEL=llama3.2    (no key at all, runs on your machine)
#
# Gemini needs no base url: ENTRY_AI=gemini, GEMINI_API_KEY=..., and the model
# defaults to gemini-2.0-flash.
# ---------------------------------------------------------------------------
ENTRY_AI=off
ENTRY_AI_BASE_URL=
ENTRY_AI_KEY=
ENTRY_AI_MODEL=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — reading a photo of a bill or a screenshot straight into rows on
# /import, from a freshly-picked photo or one already sitting in the Inbox.
#
# A SEPARATE setting from ENTRY_AI above, because it needs a VISION-capable
# model and that is a shorter, different list from a free fast text model —
# the model that reads a sentence is rarely the one that reads a photo. Off by
# default: without it, the "Copy the prompt" panel on /import still works
# exactly as before, pasted by hand into any assistant.
#
#   IMPORT_AI=off                 no photo conversion (the default)
#   IMPORT_AI=openai-compatible   + IMPORT_AI_BASE_URL, IMPORT_AI_KEY, IMPORT_AI_MODEL
#   IMPORT_AI=gemini              + GEMINI_API_KEY [, IMPORT_AI_MODEL]
#   IMPORT_AI=anthropic           + ANTHROPIC_API_KEY [, IMPORT_AI_MODEL]   (not free)
#
# Free vision setups — check the provider's current model list before relying
# on a name here, as free vision models change faster than free text ones:
#
#   Groq        IMPORT_AI_BASE_URL=https://api.groq.com/openai/v1
#               IMPORT_AI_MODEL=<their current vision model>
#   OpenRouter  IMPORT_AI_BASE_URL=https://openrouter.ai/api/v1
#               IMPORT_AI_MODEL=<a vision model id ending ":free">
#   Ollama      IMPORT_AI_BASE_URL=http://localhost:11434/v1
#               IMPORT_AI_MODEL=llava        (no key, fully local)
#   Gemini      IMPORT_AI=gemini, GEMINI_API_KEY=... (reuses the key above)
#               defaults to gemini-2.0-flash, which already reads images
# ---------------------------------------------------------------------------
IMPORT_AI=off
IMPORT_AI_BASE_URL=
IMPORT_AI_KEY=
IMPORT_AI_MODEL=

# OPTIONAL — the plain-English question interface at /ask. This one genuinely
# needs a key; unlike voice entry there is no offline fallback. Absent = /ask
# shows a setup message rather than failing.
ANTHROPIC_API_KEY=

# --- Reminders -------------------------------------------------------------
# Push notifications to the iPhone home-screen app. Generate with
# `npm run gen:vapid`. Without all three, the Reminders page says push is not
# configured and offers the calendar feed instead.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real mailto: or https: URL. Push services reject a made-up one, and it is
# how they contact you if deliveries start failing.
VAPID_SUBJECT=

# Guards /api/cron/reminders, which Vercel Cron calls once a day. UNSET MEANS
# THE ENDPOINT REFUSES EVERYONE — an open URL that makes a phone buzz is a
# nuisance anyone can inflict. At least 16 characters.
CRON_SECRET=

# The calendar feed's secret. THE URL IS THE CREDENTIAL: anyone holding
# /api/calendar?token=... can read what you owe and when. At least 16
# characters; unset means the feed is off, not public.
#
# It travels in the query string because a calendar subscription cannot send
# headers, so IT WILL APPEAR IN SERVER REQUEST LOGS. Rotate it if a log is
# ever shared or pasted anywhere; rotating revokes every subscribed device.
CALENDAR_TOKEN=
